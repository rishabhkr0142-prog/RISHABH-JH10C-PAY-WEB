# ─────────────────────────────────────────────────────────────
# RISHABH JH10C PAY WEB — environment variable names only
# Copy to ".env.local" (or ".env") and fill values yourself.
# Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# ── MongoDB ──────────────────────────────────────────────────
# Include the database name in the URI (recommended):
#   mongodb+srv://user:pass@cluster.mongodb.net/rishabh_jh10c?retryWrites=true&w=majority
MONGODB_URI=
# Optional override used only when the URI has no database name.
MONGODB_DB_NAME=test

# ── Authentication (NextAuth.js + Google/Discord OAuth2) ─────
NEXTAUTH_SECRET=
NEXTAUTH_URL=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Admin access ─────────────────────────────────────────────
ADMIN_DISCORD_ID=

# ── UPI Payment Gateway (Server Only) ────────────────────────
FAMPAY_UPI_ID=
UPI_ID=
UPI_NAME=

# ── Webhook secret ───────────────────────────────────────────
WEBHOOK_SECRET=

# ── Anti-Spam & Order Settings ───────────────────────────────
ORDER_COOLDOWN_MINUTES=

# ── Public site settings (browser-visible) ──────────────────
# Canonical public URL for sitemap, robots, canonical and OG tags.
NEXT_PUBLIC_SITE_URL=https://rishabh-jh10c-pay-web.vercel.app
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_DISCORD_INVITE_URL=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CURRENCY=
# Optional Google Analytics 4 measurement ID (leave blank to disable analytics).
NEXT_PUBLIC_GA_ID=

# ── License Delivery (Server Only) ───────────────────────────
MANI_API_KEY=
MANI_APP_ID_UID=
MANI_APP_ID_LIB=
DISCORD_BOT_TOKEN=
LOADER_URL=

# Inventory alerts + reservation sweep (server only)
DISCORD_STOCK_CHANNEL_ID=
LOW_STOCK_ALERT_THRESHOLD=3
STOCK_CRON_SECRET=

# Cloudinary (product image uploads — server only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
