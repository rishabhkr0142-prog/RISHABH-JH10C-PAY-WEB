# ─────────────────────────────────────────────────────────────
# RISHABH JH10C PAY WEB — environment variables example
# Copy this file to ".env.local" and fill in real values.
# On Vercel, add each of these in: Project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────

# ── MongoDB ──────────────────────────────────────────────────
# Get this from MongoDB Atlas → your cluster → Connect → Drivers
# Format: mongodb+srv://<DB_USER>:<DB_PASSWORD>@<cluster-url>/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<DB_USER>:<DB_PASSWORD>@<cluster-url>/<dbname>?retryWrites=true&w=majority

# ── Authentication (NextAuth.js + Discord OAuth2) ────────────
# Generate a secret with:  openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here
# Local dev: http://localhost:3000   |   Production: https://your-domain.vercel.app
NEXTAUTH_URL=http://localhost:3000

# From Discord Developer Portal → your Application → OAuth2
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret

# ── Admin access ─────────────────────────────────────────────
# Your Discord user ID (enable Developer Mode in Discord,
# right-click your own name in the member list → "Copy User ID").
# Only this ID can open /admin.
ADMIN_DISCORD_ID=your_discord_user_id

# ── UPI Payment Gateway (Server Only — Never hardcode in client) ──
FAMPAY_UPI_ID=your_fampay_id@fam
UPI_ID=your_fampay_id@fam
UPI_NAME="RISHABH JH10C PAY"

# ── Google Apps Script Automated Webhook Secret ───────────────
# Secret key shared between Google Apps Script (FamPay email reader) and Next.js /api/pay/webhook
WEBHOOK_SECRET=generate_a_random_32_to_64_character_hex_or_passphrase

# ── Anti-Spam & Order Settings ──────────────────────────────
# Cooldown period in minutes between orders for regular users (admins exempt)
ORDER_COOLDOWN_MINUTES=10

# ── Public site settings (safe to expose to the browser) ─────
# Support contact shown on the Support page and footer
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
# Discord invite shown on "Join Discord" buttons
NEXT_PUBLIC_DISCORD_INVITE_URL=https://discord.gg/your-invite
# Currency symbol used on product prices (₹, $, €, ...)
NEXT_PUBLIC_CURRENCY=₹

# ==== License Delivery (Server Only, never expose to client) ====
# Mani auth panel secret API token (licenses/generate only)
MANI_API_KEY=
# Auth panel application ids — one per license product (server only)
MANI_APP_ID_UID=loader_uid_bypass_m272
MANI_APP_ID_LIB=loader_lib_bypass_m272
# Discord bot token (same bot already connected to the auth panel gateway).
# Used only for REST DM delivery (no gateway login).
DISCORD_BOT_TOKEN=
# Loader download link. Served to buyers through /api/loader (never in client data).
LOADER_URL=
