# ─────────────────────────────────────────────────────────────
# RISHABH JH10C PAY WEB — environment variable names only
# Copy to ".env.local" (or ".env") and fill values yourself.
# Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# ── MongoDB ──────────────────────────────────────────────────
MONGODB_URI=

# ── Authentication (NextAuth.js + Google/Discord OAuth2) ─────
NEXTAUTH_SECRET=
NEXTAUTH_URL=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Admin access ─────────────────────────────────────────────
ADMIN_DISCORD_ID=

# ── UPI Payment Gateway (Server Only) ────────────────────────
FAMPAY_UPI_ID=
UPI_ID=
UPI_NAME=

# ── Webhook secret ───────────────────────────────────────────
WEBHOOK_SECRET=

# ── Anti-Spam & Order Settings ───────────────────────────────
ORDER_COOLDOWN_MINUTES=

# ── Public site settings (browser-visible) ──────────────────
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_DISCORD_INVITE_URL=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CURRENCY=

# ── License Delivery (Server Only) ───────────────────────────
MANI_API_KEY=
MANI_APP_ID_UID=
MANI_APP_ID_LIB=
DISCORD_BOT_TOKEN=
LOADER_URL=

# Cloudinary (product image uploads — server only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
